# Copia a .env y rellena. NUNCA commitees .env.
# Contrasena especifica de app de Apple (account.apple.com -> Contrasenas especificas de app).
# Formato xxxx-xxxx-xxxx-xxxx. La contrasena normal del Apple ID NO funciona.
PROGRAMADOR_IMAP_HOST=imap.mail.me.com
PROGRAMADOR_IMAP_PORT=993
PROGRAMADOR_SMTP_HOST=smtp.mail.me.com
PROGRAMADOR_SMTP_PORT=587
PROGRAMADOR_EMAIL=lestersv@icloud.com
PROGRAMADOR_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Rutas locales
PROGRAMADOR_DB=./programador.db
PROGRAMADOR_CONFIG=./config/entities.yaml
PROGRAMADOR_ATTACHMENTS_DIR=./attachments

# Carpetas IMAP a sincronizar (separadas por coma)
PROGRAMADOR_FOLDERS=INBOX
# Dias de historico en la primera sincronizacion
PROGRAMADOR_INITIAL_DAYS=180

# Publicacion en Supabase (opcional): el Mac sube los ultimos dias por HTTPS para
# que el resumen matutino, que corre en la nube y no puede hablar IMAP, los lea.
# La clave es la PUBLICABLE (anon) del proyecto: por RLS solo puede insertar.
PROGRAMADOR_SUPABASE_URL=https://bowuuimtsgeelgmhsdgu.supabase.co
PROGRAMADOR_SUPABASE_KEY=
PROGRAMADOR_PUBLISH_DAYS=3
